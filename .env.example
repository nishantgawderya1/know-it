# Copy to .env and fill in. Never commit .env — real values live in Vercel / Fly secrets.

# --- Supabase / Postgres ---
#
# DATABASE_URL — the SESSION POOLER, used by the worker and the web read paths.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Use the pooler, not the direct host, for anything running in a container. The direct
# host (db.<ref>.supabase.co) publishes an AAAA record and no A record — it is IPv6-only.
# That works from a laptop with IPv6 and fails with ENOTFOUND inside Docker's default
# IPv4 network, which is exactly the sort of thing that passes locally and breaks on
# deploy. The pooler resolves over IPv4.
#
# Port 5432 on the pooler is session mode; 6543 is transaction mode. Session mode is
# correct here because postgres.js uses prepared statements, which transaction mode does
# not support unless you also pass `prepare: false`.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# DIRECT_DATABASE_URL — migrations only. The pooler cannot run DDL reliably, and this is
# run from a developer machine rather than a container, so IPv6-only is fine here.
DIRECT_DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# --- Worker ---
# Sources claimed per scheduler tick
WORKER_BATCH_SIZE=10
# Scheduler tick interval, milliseconds
WORKER_TICK_MS=30000
# Sent on every outbound request. Identifies us to publishers — keep it honest and
# reachable. Individual sources can override it via sources.user_agent.
WORKER_USER_AGENT=KnowItBot/0.1 (+https://knowit.example/bot)

# --- Adapters ---
# github_api adapter: 60 req/hr unauthenticated, 5000/hr with a token.
GITHUB_TOKEN=

# --- Web ---
NEXT_PUBLIC_APP_NAME=KnowIt

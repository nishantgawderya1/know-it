# Copy to .env and fill in. Never commit .env — real values live in Vercel / Fly env vars.

# --- Supabase / Postgres ---
# Pooled connection string (worker + web read paths)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres
# Direct connection (migrations only — pooler cannot run DDL reliably)
DIRECT_DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# --- Worker ---
# Sources claimed per scheduler tick
WORKER_BATCH_SIZE=10
# Scheduler tick interval, milliseconds
WORKER_TICK_MS=30000
# Sent on every outbound request. Identifies us to publishers — keep it honest and reachable.
WORKER_USER_AGENT=KnowItBot/0.1 (+https://knowit.example/bot)

# --- Adapters ---
# github_api adapter: 60 req/hr unauthenticated, 5000/hr with a token.
GITHUB_TOKEN=

# --- Web ---
NEXT_PUBLIC_APP_NAME=KnowIt
